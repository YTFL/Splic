# ==============================================================================
# Splic — Unified Root Environment Configuration (.env.example)
# ==============================================================================
# Copy this template to .env.local at the repository root:
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# 1. Real credentials belong EXCLUSIVELY in the root .env.local file.
# 2. Never commit .env.local or service account JSON files to version control.
# 3. Only NEXT_PUBLIC_* variables may be bundled into client-side frontend code.
# 4. Never prefix backend private credentials (FIREBASE_SERVICE_ACCOUNT_JSON,
#    COMPOSIO_API_KEY) with NEXT_PUBLIC_.
# ==============================================================================

# ==============================================================================
# SECTION 1: FRONTEND FIREBASE WEB SDK — PUBLIC CONFIGURATION
# ==============================================================================
# These non-secret parameters are public project metadata used by the Firebase
# Web Client SDK in the Creator Dashboard frontend (Next.js) to initialize
# user authentication (Google Sign-In, Email/Password, etc.).
#
# INSTRUCTIONS FOR FRONTEND (Next.js):
# In your Next.js project configuration (e.g. next.config.js / next.config.mjs),
# deterministically load this repository root .env.local file using @next/env:
#
#   import { loadEnvConfig } from "@next/env";
#   import path from "node:path";
#   import { fileURLToPath } from "node:url";
#
#   const projectDir = fileURLToPath(new URL(".", import.meta.url));
#   const rootDir = path.resolve(projectDir, ".."); // Resolves to Splic repository root
#   loadEnvConfig(rootDir);
#
# Next.js will automatically inline NEXT_PUBLIC_* variables into the browser bundle
# at build time while keeping backend private secrets strictly server-side.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleFakeApiKeyForTemplateOnly
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=splic-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=splic-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=splic-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# ==============================================================================
# SECTION 2: BACKEND FIREBASE ADMIN — PRIVATE CONFIGURATION
# ==============================================================================
# Used strictly by backend/composio/ to initialize the Firebase Admin SDK
# and verify incoming client Bearer JWT tokens.
#
# INSTRUCTIONS FOR FIREBASE_SERVICE_ACCOUNT_JSON:
# 1. Download your service account private key JSON from:
#    Firebase Console > Project Settings > Service accounts > "Generate new private key".
# 2. Minify the entire JSON file into a single line string.
#    (e.g., using: tr -d '\n' < your-key.json)
# 3. Paste the single-line JSON string below.
# 4. Ensure FIREBASE_PROJECT_ID matches the "project_id" inside the JSON.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=splic-app
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"splic-app","private_key_id":"mock_key_id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC3...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@splic-app.iam.gserviceaccount.com","client_id":"123456789012345678901"}

# Allowed clock drift (seconds, 0-60) when verifying Firebase ID tokens.
FIREBASE_CLOCK_SKEW_SECONDS=10

# ==============================================================================
# SECTION 3: COMPOSIO — PRIVATE CONFIGURATION
# ==============================================================================
# Private credentials and user tenant mapping for Composio OAuth & Toolkits.
# Obtain your API key from https://app.composio.dev/settings
# ------------------------------------------------------------------------------
# User identity is strictly derived from the verified Firebase UID (no static shared identity).
COMPOSIO_API_KEY=your_composio_api_key_here

# ==============================================================================
# SECTION 4: SERVER & CORS NETWORKING
# ==============================================================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend URLs allowed by CORS (comma-separated origins)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
BACKEND_URL=http://localhost:8000
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

