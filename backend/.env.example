# ============================================================
#  Splic Backend — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ============================================================

# ----------------------------------------------------------
# Sarvam AI
# Get your key at https://dashboard.sarvam.ai/
# ----------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_subscription_key

# ----------------------------------------------------------
# LLM fallback provider if the Sarvam director (glm5.3-flash) fails or times out
# Options: none | groq | gemini
# ----------------------------------------------------------
FALLBACK_PROVIDER=none

# ----------------------------------------------------------
# Groq (optional — only used when FALLBACK_PROVIDER=groq)
# ----------------------------------------------------------
GROQ_API_KEY=

# ----------------------------------------------------------
# Gemini (optional — only used when FALLBACK_PROVIDER=gemini)
# ----------------------------------------------------------
GEMINI_API_KEY=

# ----------------------------------------------------------
# Optional overrides
# ----------------------------------------------------------
# SARVAM_STT_MODEL=saaras:v4        # saaras:v4 (latest, default) | saaras:v3
# SARVAM_STT_MODE=translit          # transcribe | translate | verbatim | translit | codemix
# SARVAM_LLM_MODEL=glm5.3-flash     # director model on /v2 (default) | glm5.3 | sarvam-105b
# SARVAM_REASONING_EFFORT=          # low | medium | high; sent by default only for sarvam-105b
# SARVAM_MAX_TOKENS=8000            # director completion budget (0 = omit)
# SARVAM_LLM_TIMEOUT=240            # seconds
# FFMPEG_PATH=            # defaults to ffmpeg on PATH, then the imageio-ffmpeg bundled binary
# STICKER_FETCH=true      # false = never scrape the web; use cached / bundled stickers only

# ----------------------------------------------------------
# Server
# ----------------------------------------------------------
PORT=8000
