# ==============================================================================
# Splic Composio Backend Configuration Template
# ==============================================================================
# NOTE: The Composio backend automatically loads configuration from the repository
# root environment file:
#   Splic/.env.local
#
# Please configure your credentials in the root .env.local file (see root .env.example).
#
# This file is a reference documenting backend-specific variables.
# ==============================================================================

# Composio API Credentials
# Get your API key from https://app.composio.dev/settings
# Note: Every authenticated creator uses their verified Firebase UID as their Composio user identity.
COMPOSIO_API_KEY=your_composio_api_key_here

# Firebase Admin SDK Configuration (loaded from root .env.local)
# Set FIREBASE_PROJECT_ID and paste your single-line service account JSON:
FIREBASE_PROJECT_ID=splic-app
FIREBASE_SERVICE_ACCOUNT_JSON=

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (Creator Dashboard, Timeline Studio)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
BACKEND_URL=http://localhost:8000

# Social Platform OAuth Post-Auth Redirect URL
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback
